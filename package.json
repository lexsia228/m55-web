{
    "name": "m55-phase6-nextjs-integration-kit",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "guard:clerk": "node .github/scripts/guard_clerk_await.mjs",
        "dev": "node scripts/audit_gate.mjs --fast && next dev",
        "audit": "node scripts/audit_gate.mjs",
        "verify:m55-ssot": "node scripts/verify-m55-commercial-ssot.mjs",
        "verify:m55-control-tower": "node scripts/verify-m55-control-tower.mjs",
        "m55:context": "node scripts/m55-control-tower-context.mjs",
        "verify:m55-worktree-preflight:local": "node scripts/verify-m55-commercial-ssot.mjs --local-worktree-preflight",
        "verify:m55-experience-control-plane": "node scripts/verify-m55-experience-control-plane.mjs",
        "verify:m55-asset-ledger": "node scripts/verify-m55-asset-ledger.mjs",
        "verify:m55-premium-experience": "node scripts/verify-m55-premium-experience.mjs",
        "verify:m55-premium-proof-records": "node scripts/verify-m55-premium-proof-records.mjs",
        "verify:m55-commercial-visual-quality": "node scripts/verify-m55-commercial-visual-quality.mjs",
        "verify:m55-method-authority": "node scripts/verify-m55-method-authority.mjs",
        "verify:m55-commercial-quality-control-plane": "node scripts/verify-m55-commercial-quality-control-plane.mjs",
        "generate:m55-commercial-quality-approval-pack": "node scripts/verify-m55-commercial-quality-control-plane.mjs --emit-candidate-pack",
        "verify:product-authority:bootstrap": "node scripts/product-authority/cli.mjs verify",
        "verify:product-authority": "node scripts/product-authority/validate.mjs --steady-state",
        "test:product-authority": "node --test scripts/product-authority/__tests__/*.test.mjs",
        "observe:production-diagnostics": "node scripts/product-authority/observe-production-diagnostics.mjs",
        "run:production-observation": "node scripts/product-authority/run-production-observation.mjs",
        "generate:product-authority": "node scripts/product-authority/cli.mjs generate-handoff",
        "build": "next build",
        "build:strict": "node scripts/audit_gate.mjs && next build",
        "ci:build": "npm run build:strict",
        "export": "node scripts/audit_gate.mjs && next build",
        "cap:sync": "npx cap sync",
        "cap:open:ios": "npx cap open ios",
        "cap:open:android": "npx cap open android",
        "mobile:sync": "npx cap sync",
        "mobile:open:ios": "npx cap open ios",
        "mobile:open:android": "npx cap open android",
        "lint:ssot": "eslint \"app/home\" \"app/how-m55-works\" \"app/ten-views\" \"app/support\" \"app/legal\" \"app/purchase\" \"app/dtr/page.tsx\" \"app/dtr/lp/page.tsx\" \"app/pricing/page.tsx\" \"components/home\" \"components/pages\" \"components/shell\" --max-warnings 0",
        "test:e2e:install": "playwright install chromium",
        "test:e2e:visual": "playwright test e2e/home-core-visual.spec.ts",
        "test:e2e:experience-control-plane": "playwright test e2e/experience-control-plane-visual.spec.ts",
        "test:e2e:self-funnel": "playwright test e2e/self-funnel-runtime-state.spec.ts",
        "test:e2e:self-funnel-growth": "playwright test e2e/self-funnel-growth-share.spec.ts",
        "test:e2e:premium-experience-evidence": "node scripts/run-premium-experience-evidence.mjs",
        "test:m55-commercial-visual-quality": "tsx --test lib/m55/commercialUx/visualQuality/commercialVisualQuality.test.ts",
        "test:m55-method-authority": "tsx --test lib/m55/method/m55MethodAuthority.test.ts lib/m55/method/m55MethodRouteConsumption.test.ts",
        "test:e2e:commercial-visual-quality": "playwright test e2e/commercial-visual-quality.spec.ts",
        "test:e2e:method-authority-placement": "playwright test e2e/method-authority-placement.spec.ts",
        "test:e2e:home-continuous-responsive": "node scripts/run-m55-home-continuous-responsive-e2e.mjs",
        "test:m55-e2e-clean-capture-env": "node --test scripts/m55-e2e-clean-capture-env.test.mjs",
        "test:m55-commercial-quality-control-plane": "tsx --test lib/commercialQuality/commercialQuality.test.ts",
        "test:e2e:commercial-quality-control-plane": "node scripts/run-m55-commercial-quality-control-plane-e2e.mjs",
        "test:e2e:commercial-visual-regression": "playwright test e2e/commercial-visual-regression.spec.ts",
        "test:premium-experience-verifier": "tsx --test lib/m55/commercialUx/premiumExperience/premiumExperienceVerifierNegative.test.ts lib/m55/commercialUx/premiumExperience/premiumExperienceProofNegative.test.ts lib/m55/commercialUx/premiumExperience/premiumShareFallbackVisibility.test.ts lib/m55/commercialUx/premiumExperience/premiumExperience.test.ts"
    },
    "dependencies": {
        "@capacitor/filesystem": "^6.0.0",
        "@capacitor/haptics": "^6.0.0",
        "@capacitor/preferences": "^6.0.0",
        "@clerk/localizations": "3.35.4",
        "@clerk/nextjs": "6.37.4",
        "@supabase/supabase-js": "^2.97.0",
        "@vercel/analytics": "^1.6.1",
        "next": "^15.1.0",
        "openai": "^6.32.0",
        "pg": "8.20.0",
        "posthog-js": "^1.359.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "stripe": "^20.4.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.12.1",
        "@capacitor/android": "^6.0.0",
        "@capacitor/cli": "^6.0.0",
        "@capacitor/core": "^6.0.0",
        "@capacitor/ios": "^6.0.0",
        "@eslint/js": "^9.16.0",
        "@playwright/test": "^1.50.0",
        "@types/pg": "8.20.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.16.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "tsx": "4.23.1",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.18.2"
    }
}
