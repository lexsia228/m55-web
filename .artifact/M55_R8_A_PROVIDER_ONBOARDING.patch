+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { buildPublicReadinessSnapshotV1 } from './readinessModel.ts';
+
+describe('R8-A readiness — §8 vs deployed R7', () => {
+  it('allows deployed R7 referral while Operating Model gate is open', () => {
+    const snapshot = buildPublicReadinessSnapshotV1({
+      profileStatus: 'ACTIVE',
+      referralIssuePermittedDeployedR7: true,
+      complianceBlocksReferral: false,
+      taxProfileReady: false,
+      linkState: 'NOT_STARTED',
+      providerSnapshot: null,
+      v1JapanBlocked: false,
+    });
+    assert.equal(snapshot.referralIssuePermittedDeployedR7, true);
+    assert.equal(snapshot.operatingModelReferralGateMet, false);
+    assert.ok(snapshot.operatingModelSteps.includes('REFERRAL_URL_ACTIVE_DEPLOYED_R7'));
+    assert.ok(!snapshot.operatingModelSteps.includes('REFERRAL_URL_ACTIVE_OPERATING_MODEL'));
+    assert.ok(snapshot.blockReasons.includes('PAYOUT_SETTLEMENT_NOT_IMPLEMENTED'));
+  });
+
+  it('blocks onboarding actions messaging for suspended profiles', () => {
+    const snapshot = buildPublicReadinessSnapshotV1({
+      profileStatus: 'SUSPENDED',
+      referralIssuePermittedDeployedR7: false,
+      complianceBlocksReferral: false,
+      taxProfileReady: true,
+      linkState: 'NOT_STARTED',
+      providerSnapshot: null,
+      v1JapanBlocked: false,
+    });
+    assert.ok(snapshot.blockReasons.includes('PROFILE_SUSPENDED'));
+  });
+});
diff --git a/lib/m55/creatorProvider/onboardingService.ts b/lib/m55/creatorProvider/onboardingService.ts
new file mode 100644
index 00000000..c93eeea2
--- /dev/null
+++ b/lib/m55/creatorProvider/onboardingService.ts
@@ -0,0 +1,223 @@
+import 'server-only';
+import {
+  isCreatorReferralCapabilityPermittedV1,
+  resolveCreatorContextFromSession,
+  type ResolvedCreatorContext,
+} from '../creatorDashboard/creatorContext';
+import { buildPublicReadinessSnapshotV1 } from './readinessModel';
+import { loadTaxProfileV1, upsertTaxProfileV1 } from './taxProfileRepository';
+import {
+  appendProviderOnboardingEventV1,
+  completeOnboardingSessionIfOwnedV1,
+  createOnboardingSessionV1,
+  loadProviderAccountByEconomicIdentityV1,
+  recordOnboardingLinkIssuedV1,
+  syncProviderSnapshotV1,
+  upsertProviderAccountStubV1,
+} from './providerAccountRepository';
+import {
+  assertSafeRedirectUrl,
+  buildCreatorPortalProviderRefreshUrl,
+  buildCreatorPortalProviderReturnUrl,
+  resolveCreatorProviderPublicOrigin,
+  resolveStripeConnectAdapter,
+  type StripeConnectAdapter,
+} from './stripeConnectAdapter';
+import { parseClientIdempotencyKey, type R8PublicReadinessSnapshotV1, type R8TaxProfileInputV1 } from './contract';
+
+export type ProviderStatusBundleV1 = {
+  readiness: R8PublicReadinessSnapshotV1;
+  taxProfile: Awaited<ReturnType<typeof loadTaxProfileV1>>;
+  onboardingUrl: string | null;
+  adapterMode: StripeConnectAdapter['mode'];
+};
+
+async function complianceBlocksReferral(ctx: Extract<ResolvedCreatorContext, { ok: true }>): Promise<boolean> {
+  if (ctx.profileStatus !== 'ACTIVE') return false;
+  try {
+    const permitted = await isCreatorReferralCapabilityPermittedV1(
+      ctx.creatorEconomicIdentityId,
+      ctx.profileStatus,
+    );
+    return !permitted;
+  } catch {
+    throw new Error('PROVIDER_STATUS_UNAVAILABLE');
+  }
+}
+
+export async function buildProviderStatusBundleV1(options?: {
+  refreshProvider?: boolean;
+  returnSessionId?: string | null;
+  adapter?: StripeConnectAdapter;
+}): Promise<
+  | { ok: false; error: 'UNAUTHORIZED' | 'CREATOR_PROFILE_REQUIRED' | 'PORTAL_UNAVAILABLE' }
+  | { ok: true; bundle: ProviderStatusBundleV1 }
+> {
+  const ctx = await resolveCreatorContextFromSession();
+  if (!ctx.ok) return ctx;
+
+  const adapter = options?.adapter ?? resolveStripeConnectAdapter();
+  const taxProfile = await loadTaxProfileV1(ctx.creatorEconomicIdentityId);
+  let providerRow = await loadProviderAccountByEconomicIdentityV1(ctx.creatorEconomicIdentityId);
+
+  const sessionId = options?.returnSessionId?.trim() || null;
+  const shouldPollProvider =
+    options?.refreshProvider === true ||
+    (sessionId != null && sessionId.length > 0);
+
+  if (shouldPollProvider && providerRow?.stripeAccountId) {
+    const ownedSessionOk =
+      !sessionId ||
+      (await completeOnboardingSessionIfOwnedV1({
+        creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+        sessionId,
+      }));
+    if (ownedSessionOk || options?.refreshProvider) {
+      try {
+        const snapshot = await adapter.retrieveAccountSnapshot(providerRow.stripeAccountId);
+        providerRow = await syncProviderSnapshotV1({
+          creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+          stripeAccountId: providerRow.stripeAccountId,
+          snapshot,
+        });
+        await appendProviderOnboardingEventV1({
+          creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+          eventType: 'PROVIDER_SNAPSHOT_SYNCED',
+          idempotencyKey: `sync:${providerRow.lastSyncedAt ?? Date.now()}:${providerRow.stripeAccountId}`,
+          payloadRedacted: { linkState: providerRow.linkState },
+        });
+      } catch {
+        // Fail-closed: do not trust client return without successful provider poll.
+      }
+    }
+  }
+
+  const complianceHold = await complianceBlocksReferral(ctx);
+  const readiness = buildPublicReadinessSnapshotV1({
+    profileStatus: ctx.profileStatus,
+    referralIssuePermittedDeployedR7: ctx.referralIssuePermitted,
+    complianceBlocksReferral: complianceHold,
+    taxProfileReady: taxProfile != null,
+    linkState: providerRow?.linkState ?? 'NOT_STARTED',
+    providerSnapshot: providerRow?.lastProviderSnapshot ?? null,
+    v1JapanBlocked: false,
+  });
+
+  return {
+    ok: true,
+    bundle: {
+      readiness,
+      taxProfile,
+      onboardingUrl: null,
+      adapterMode: adapter.mode,
+    },
+  };
+}
+
+export async function saveCreatorTaxProfileForSessionV1(
+  input: R8TaxProfileInputV1,
+): Promise<
+  | { ok: false; error: 'UNAUTHORIZED' | 'CREATOR_PROFILE_REQUIRED' | 'FORBIDDEN' | 'TAX_PROFILE_INVALID' | 'TAX_PROFILE_UNAVAILABLE' }
+  | { ok: true; taxProfile: Awaited<ReturnType<typeof upsertTaxProfileV1>> }
+> {
+  const ctx = await resolveCreatorContextFromSession();
+  if (!ctx.ok) {
+    return { ok: false, error: ctx.error === 'PORTAL_UNAVAILABLE' ? 'TAX_PROFILE_UNAVAILABLE' : ctx.error };
+  }
+  if (ctx.profileStatus !== 'ACTIVE') {
+    return { ok: false, error: 'FORBIDDEN' };
+  }
+  try {
+    const taxProfile = await upsertTaxProfileV1(ctx.creatorEconomicIdentityId, input);
+    return { ok: true, taxProfile };
+  } catch (cause) {
+    const message = cause instanceof Error ? cause.message : '';
+    if (message === 'TAX_PROFILE_INVALID' || message === 'V1_ELIGIBILITY_BLOCKED') {
+      return { ok: false, error: 'TAX_PROFILE_INVALID' };
+    }
+    return { ok: false, error: 'TAX_PROFILE_UNAVAILABLE' };
+  }
+}
+
+export async function startCreatorProviderOnboardingV1(body: {
+  action: 'START' | 'RESUME';
+  idempotencyKey: string;
+  adapter?: StripeConnectAdapter;
+}): Promise<
+  | { ok: false; error: string }
+  | { ok: true; onboardingUrl: string; sessionId: string; reused: boolean }
+> {
+  const ctx = await resolveCreatorContextFromSession();
+  if (!ctx.ok) return { ok: false, error: ctx.error };
+  if (ctx.profileStatus !== 'ACTIVE') return { ok: false, error: 'FORBIDDEN' };
+
+  const clientKey = parseClientIdempotencyKey(body.idempotencyKey);
+  if (!clientKey) return { ok: false, error: 'INVALID_INPUT' };
+
+  const taxProfile = await loadTaxProfileV1(ctx.creatorEconomicIdentityId);
+  if (!taxProfile) return { ok: false, error: 'TAX_PROFILE_REQUIRED' };
+
+  const complianceHold = await complianceBlocksReferral(ctx);
+  if (complianceHold) return { ok: false, error: 'COMPLIANCE_HOLD' };
+
+  const adapter = body.adapter ?? resolveStripeConnectAdapter();
+  const origin = resolveCreatorProviderPublicOrigin();
+  const refreshUrl = assertSafeRedirectUrl(buildCreatorPortalProviderRefreshUrl(), origin);
+  if (!refreshUrl) return { ok: false, error: 'ORIGIN_MISCONFIGURED' };
+
+  const createKey = `create:${ctx.creatorEconomicIdentityId}:${clientKey}`;
+  let providerRow = await loadProviderAccountByEconomicIdentityV1(ctx.creatorEconomicIdentityId);
+  if (!providerRow?.stripeAccountId) {
+    try {
+      const stub = await adapter.createConnectedAccountStub({
+        economicIdentityId: ctx.creatorEconomicIdentityId,
+        idempotencyKey: createKey,
+      });
+      providerRow = await upsertProviderAccountStubV1({
+        creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+        createIdempotencyKey: createKey,
+        stripeAccountId: stub.accountId,
+      });
+      await appendProviderOnboardingEventV1({
+        creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+        eventType: 'PROVIDER_ACCOUNT_STUB',
+        idempotencyKey: createKey,
+        payloadRedacted: { accountIdSuffix: stub.accountId.slice(-6) },
+      });
+    } catch {
+      return { ok: false, error: 'PROVIDER_ONBOARDING_UNAVAILABLE' };
+    }
+  }
+
+  const { sessionId, reused } = await createOnboardingSessionV1({
+    creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+    clientIdempotencyKey: clientKey,
+    returnPath: '/creator/portal',
+  });
+
+  const returnUrl = assertSafeRedirectUrl(buildCreatorPortalProviderReturnUrl(sessionId), origin);
+  if (!returnUrl || !providerRow.stripeAccountId) {
+    return { ok: false, error: 'ORIGIN_MISCONFIGURED' };
+  }
+
+  try {
+    const link = await adapter.createAccountOnboardingLink({
+      accountId: providerRow.stripeAccountId,
+      refreshUrl,
+      returnUrl,
+    });
+    await recordOnboardingLinkIssuedV1({
+      creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+      sessionId,
+    });
+    await appendProviderOnboardingEventV1({
+      creatorEconomicIdentityId: ctx.creatorEconomicIdentityId,
+      eventType: body.action === 'RESUME' ? 'ONBOARDING_LINK_RESUME' : 'ONBOARDING_LINK_START',
+      idempotencyKey: `link:${sessionId}:${clientKey}`,
+      payloadRedacted: { sessionId },
+    });
+    return { ok: true, onboardingUrl: link.url, sessionId, reused };
+  } catch {
+    return { ok: false, error: 'PROVIDER_ONBOARDING_UNAVAILABLE' };
+  }
+}
diff --git a/lib/m55/creatorProvider/providerAccountRepository.ts b/lib/m55/creatorProvider/providerAccountRepository.ts
new file mode 100644
index 00000000..80cf5bda
--- /dev/null
+++ b/lib/m55/creatorProvider/providerAccountRepository.ts
@@ -0,0 +1,216 @@
+import 'server-only';
+import { getSupabaseAdmin } from '../../supabaseAdmin';
+import {
+  type R8ProviderAccountSnapshotV1,
+  type R8StripeLinkStateV1,
+  isProviderPayoutReadinessGreenV1,
+  redactProviderSnapshotForStorage,
+} from './contract';
+
+export type ProviderAccountRowV1 = {
+  id: string;
+  creatorEconomicIdentityId: string;
+  stripeAccountId: string | null;
+  linkState: R8StripeLinkStateV1;
+  createIdempotencyKey: string;
+  lastOnboardingSessionId: string | null;
+  lastProviderSnapshot: R8ProviderAccountSnapshotV1 | null;
+  lastSyncedAt: string | null;
+  lastErrorCode: string | null;
+};
+
+type DbRow = {
+  id: string;
+  creator_economic_identity_id: string;
+  stripe_account_id: string | null;
+  link_state: string;
+  create_idempotency_key: string;
+  last_onboarding_session_id: string | null;
+  last_provider_snapshot: R8ProviderAccountSnapshotV1 | null;
+  last_synced_at: string | null;
+  last_error_code: string | null;
+};
+
+function mapRow(row: DbRow): ProviderAccountRowV1 {
+  return {
+    id: row.id,
+    creatorEconomicIdentityId: row.creator_economic_identity_id,
+    stripeAccountId: row.stripe_account_id,
+    linkState: row.link_state as R8StripeLinkStateV1,
+    createIdempotencyKey: row.create_idempotency_key,
+    lastOnboardingSessionId: row.last_onboarding_session_id,
+    lastProviderSnapshot: row.last_provider_snapshot,
+    lastSyncedAt: row.last_synced_at,
+    lastErrorCode: row.last_error_code,
+  };
+}
+
+const SELECT_FIELDS =
+  'id,creator_economic_identity_id,stripe_account_id,link_state,create_idempotency_key,last_onboarding_session_id,last_provider_snapshot,last_synced_at,last_error_code';
+
+export async function loadProviderAccountByEconomicIdentityV1(
+  creatorEconomicIdentityId: string,
+): Promise<ProviderAccountRowV1 | null> {
+  const db = getSupabaseAdmin() as any;
+  const { data, error } = await db
+    .from('m55_r8_stripe_connected_accounts_v1')
+    .select(SELECT_FIELDS)
+    .eq('creator_economic_identity_id', creatorEconomicIdentityId)
+    .maybeSingle();
+  if (error) throw new Error('PROVIDER_ACCOUNT_UNAVAILABLE');
+  if (!data) return null;
+  return mapRow(data as DbRow);
+}
+
+export async function appendProviderOnboardingEventV1(input: {
+  creatorEconomicIdentityId: string;
+  eventType: string;
+  idempotencyKey: string;
+  payloadRedacted?: Record<string, unknown>;
+}): Promise<void> {
+  const db = getSupabaseAdmin() as any;
+  const { error } = await db.from('m55_r8_provider_onboarding_events_v1').insert({
+    creator_economic_identity_id: input.creatorEconomicIdentityId,
+    event_type: input.eventType,
+    idempotency_key: input.idempotencyKey,
+    payload_redacted: input.payloadRedacted ?? {},
+  });
+  if (error && !String(error.message ?? '').includes('duplicate')) {
+    throw new Error('PROVIDER_EVENT_APPEND_FAILED');
+  }
+}
+
+export async function upsertProviderAccountStubV1(input: {
+  creatorEconomicIdentityId: string;
+  createIdempotencyKey: string;
+  stripeAccountId: string;
+}): Promise<ProviderAccountRowV1> {
+  const db = getSupabaseAdmin() as any;
+  const now = new Date().toISOString();
+  const { data, error } = await db
+    .from('m55_r8_stripe_connected_accounts_v1')
+    .upsert(
+      {
+        creator_economic_identity_id: input.creatorEconomicIdentityId,
+        stripe_account_id: input.stripeAccountId,
+        link_state: 'ACCOUNT_STUB',
+        create_idempotency_key: input.createIdempotencyKey,
+        updated_at: now,
+      },
+      { onConflict: 'creator_economic_identity_id' },
+    )
+    .select(SELECT_FIELDS)
+    .single();
+  if (error || !data) throw new Error('PROVIDER_ACCOUNT_UNAVAILABLE');
+  return mapRow(data as DbRow);
+}
+
+export async function recordOnboardingLinkIssuedV1(input: {
+  creatorEconomicIdentityId: string;
+  sessionId: string;
+}): Promise<void> {
+  const db = getSupabaseAdmin() as any;
+  const now = new Date().toISOString();
+  const { error } = await db
+    .from('m55_r8_stripe_connected_accounts_v1')
+    .update({
+      link_state: 'ONBOARDING_LINK_ISSUED',
+      last_onboarding_session_id: input.sessionId,
+      last_onboarding_url_issued_at: now,
+      updated_at: now,
+    })
+    .eq('creator_economic_identity_id', input.creatorEconomicIdentityId);
+  if (error) throw new Error('PROVIDER_ACCOUNT_UNAVAILABLE');
+}
+
+export async function syncProviderSnapshotV1(input: {
+  creatorEconomicIdentityId: string;
+  stripeAccountId: string;
+  snapshot: R8ProviderAccountSnapshotV1;
+}): Promise<ProviderAccountRowV1> {
+  const redacted = redactProviderSnapshotForStorage(input.snapshot);
+  const now = new Date().toISOString();
+  const green = isProviderPayoutReadinessGreenV1('ONBOARDING_LINK_ISSUED', redacted);
+  const linkState: R8StripeLinkStateV1 = green
+    ? 'PAYOUTS_CAPABILITY_ACTIVE'
+    : redacted.detailsSubmitted
+      ? 'PROVIDER_DETAILS_SUBMITTED'
+      : 'ONBOARDING_LINK_ISSUED';
+
+  const db = getSupabaseAdmin() as any;
+  const { data, error } = await db
+    .from('m55_r8_stripe_connected_accounts_v1')
+    .update({
+      stripe_account_id: input.stripeAccountId,
+      link_state: linkState,
+      last_provider_snapshot: redacted,
+      last_synced_at: now,
+      last_error_code: null,
+      updated_at: now,
+    })
+    .eq('creator_economic_identity_id', input.creatorEconomicIdentityId)
+    .select(SELECT_FIELDS)
+    .single();
+  if (error || !data) throw new Error('PROVIDER_ACCOUNT_UNAVAILABLE');
+  return mapRow(data as DbRow);
+}
+
+export async function createOnboardingSessionV1(input: {
+  creatorEconomicIdentityId: string;
+  clientIdempotencyKey: string;
+  returnPath: string;
+  ttlMs?: number;
+}): Promise<{ sessionId: string; reused: boolean }> {
+  const db = getSupabaseAdmin() as any;
+  const existing = await db
+    .from('m55_r8_provider_onboarding_sessions_v1')
+    .select('id,status,expires_at')
+    .eq('creator_economic_identity_id', input.creatorEconomicIdentityId)
+    .eq('client_idempotency_key', input.clientIdempotencyKey)
+    .maybeSingle();
+  if (existing.data?.id && existing.data.status === 'PENDING') {
+    return { sessionId: existing.data.id as string, reused: true };
+  }
+
+  const expiresAt = new Date(Date.now() + (input.ttlMs ?? 60 * 60 * 1000)).toISOString();
+  const { data, error } = await db
+    .from('m55_r8_provider_onboarding_sessions_v1')
+    .insert({
+      creator_economic_identity_id: input.creatorEconomicIdentityId,
+      client_idempotency_key: input.clientIdempotencyKey,
+      status: 'PENDING',
+      return_path: input.returnPath,
+      expires_at: expiresAt,
+    })
+    .select('id')
+    .single();
+  if (error || !data?.id) throw new Error('ONBOARDING_SESSION_UNAVAILABLE');
+  return { sessionId: data.id as string, reused: false };
+}
+
+export async function completeOnboardingSessionIfOwnedV1(input: {
+  creatorEconomicIdentityId: string;
+  sessionId: string;
+}): Promise<boolean> {
+  const db = getSupabaseAdmin() as any;
+  const { data, error } = await db
+    .from('m55_r8_provider_onboarding_sessions_v1')
+    .select('id,status,expires_at')
+    .eq('id', input.sessionId)
+    .eq('creator_economic_identity_id', input.creatorEconomicIdentityId)
+    .maybeSingle();
+  if (error || !data) return false;
+  if (data.status !== 'PENDING') return false;
+  if (new Date(data.expires_at as string).getTime() < Date.now()) {
+    await db
+      .from('m55_r8_provider_onboarding_sessions_v1')
+      .update({ status: 'EXPIRED' })
+      .eq('id', input.sessionId);
+    return false;
+  }
+  await db
+    .from('m55_r8_provider_onboarding_sessions_v1')
+    .update({ status: 'COMPLETED', completed_at: new Date().toISOString() })
+    .eq('id', input.sessionId);
+  return true;
+}
diff --git a/lib/m55/creatorProvider/readinessModel.ts b/lib/m55/creatorProvider/readinessModel.ts
new file mode 100644
index 00000000..dece3af9
--- /dev/null
+++ b/lib/m55/creatorProvider/readinessModel.ts
@@ -0,0 +1,112 @@
+import type { CreatorProfileStatus } from '../creatorDashboard/creatorContext';
+import {
+  R8_A_COMPATIBILITY_NOTE_JA,
+  type R8PublicReadinessSnapshotV1,
+  type R8ProviderAccountSnapshotV1,
+  type R8ReadinessBlockReasonV1,
+  type R8StripeLinkStateV1,
+  isProviderPayoutReadinessGreenV1,
+} from './contract';
+
+export type ReadinessInputsV1 = {
+  profileStatus: CreatorProfileStatus;
+  referralIssuePermittedDeployedR7: boolean;
+  complianceBlocksReferral: boolean;
+  taxProfileReady: boolean;
+  linkState: R8StripeLinkStateV1;
+  providerSnapshot: R8ProviderAccountSnapshotV1 | null;
+  v1JapanBlocked: boolean;
+};
+
+export function buildPublicReadinessSnapshotV1(input: ReadinessInputsV1): R8PublicReadinessSnapshotV1 {
+  const blockReasons: R8ReadinessBlockReasonV1[] = [];
+  const nextActions: string[] = [];
+  const operatingModelSteps: R8PublicReadinessSnapshotV1['operatingModelSteps'] = [
+    'CREATOR_TERMS_ACCEPTED',
+  ];
+
+  if (input.profileStatus === 'SUSPENDED') {
+    blockReasons.push('PROFILE_SUSPENDED');
+    nextActions.push('プロフィールが一時停止中です。サポートへお問い合わせください。');
+  } else if (input.profileStatus === 'REVOKED') {
+    blockReasons.push('PROFILE_REVOKED');
+    nextActions.push('プロフィールが停止されています。サポートへお問い合わせください。');
+  } else if (input.profileStatus !== 'ACTIVE') {
+    blockReasons.push('PROFILE_NOT_ACTIVE');
+    nextActions.push('Creatorプロフィールが有効化されると、受取準備の設定を進められます。');
+  }
+
+  if (input.complianceBlocksReferral) {
+    blockReasons.push('COMPLIANCE_HOLD');
+    nextActions.push('コンプライアンス確認が完了するまで、受取準備を進められません。');
+  }
+
+  if (input.v1JapanBlocked) {
+    blockReasons.push('V1_NON_JAPAN_RESIDENT_BLOCKED');
+    nextActions.push('現行バージョンでは日本在住のCreatorのみ受取準備が対象です。');
+  }
+
+  if (input.taxProfileReady) {
+    operatingModelSteps.push('TAX_PROFILE_READY');
+  } else if (input.profileStatus === 'ACTIVE') {
+    blockReasons.push('TAX_PROFILE_MISSING');
+    nextActions.push('税務プロフィール（適格請求書登録状況など）を入力してください。');
+  }
+
+  if (input.linkState !== 'NOT_STARTED') {
+    operatingModelSteps.push('STRIPE_HOSTED_ONBOARDING');
+  } else if (input.profileStatus === 'ACTIVE' && input.taxProfileReady && !input.v1JapanBlocked) {
+    blockReasons.push('PROVIDER_NOT_LINKED');
+    nextActions.push('Stripe の受取口座登録（ホスト型）を開始してください。');
+  }
+
+  const providerGreen = isProviderPayoutReadinessGreenV1(input.linkState, input.providerSnapshot);
+  if (providerGreen) {
+    operatingModelSteps.push('PROVIDER_PAYOUT_READINESS_GREEN');
+  } else if (input.linkState === 'ERROR') {
+    blockReasons.push('PROVIDER_ERROR');
+    nextActions.push('決済プロバイダ側の設定で問題が発生しました。時間をおいて再試行するか、サポートへご連絡ください。');
+  } else if (input.linkState !== 'NOT_STARTED' && input.providerSnapshot) {
+    if (!input.providerSnapshot.detailsSubmitted) {
+      blockReasons.push('PROVIDER_KYC_INCOMPLETE');
+      nextActions.push('Stripe の本人確認・口座情報の入力を完了してください。');
+    } else if (!input.providerSnapshot.payoutsEnabled || input.providerSnapshot.transfersCapability !== 'active') {
+      blockReasons.push('PROVIDER_PAYOUTS_NOT_READY');
+      nextActions.push('Stripe 側の受取準備が完了していません。オンボーディングを再開してください。');
+    } else {
+      blockReasons.push('PROVIDER_ONBOARDING_INCOMPLETE');
+      nextActions.push('受取準備の入力を続けてください。');
+    }
+  }
+
+  if (input.profileStatus === 'ACTIVE') {
+    operatingModelSteps.push('FINAL_CREATOR_ACTIVE');
+  }
+
+  if (providerGreen) {
+    operatingModelSteps.push('REFERRAL_URL_ACTIVE_OPERATING_MODEL');
+  }
+  if (input.referralIssuePermittedDeployedR7) {
+    operatingModelSteps.push('REFERRAL_URL_ACTIVE_DEPLOYED_R7');
+  }
+
+  blockReasons.push('PAYOUT_SETTLEMENT_NOT_IMPLEMENTED');
+  nextActions.push('コミッションの出金・精算は R8 完了までは開始されません（現金送金は無効）。');
+
+  return {
+    schemaVersion: '2026-10-29-v1',
+    profileStatus: input.profileStatus,
+    operatingModelSteps,
+    blockReasons: [...new Set(blockReasons)],
+    taxProfileReady: input.taxProfileReady,
+    providerLinkState: input.linkState,
+    providerPayoutReadinessGreen: providerGreen,
+    payoutSettlementAvailable: false,
+    productionCashActivation: false,
+    referralIssuePermittedDeployedR7: input.referralIssuePermittedDeployedR7,
+    operatingModelReferralGateMet: providerGreen,
+    compatibilityNote: R8_A_COMPATIBILITY_NOTE_JA,
+    providerSnapshot: input.providerSnapshot,
+    nextActions: [...new Set(nextActions)],
+  };
+}
diff --git a/lib/m55/creatorProvider/stripeConnectAdapter.ts b/lib/m55/creatorProvider/stripeConnectAdapter.ts
new file mode 100644
index 00000000..7d5dc7d6
--- /dev/null
+++ b/lib/m55/creatorProvider/stripeConnectAdapter.ts
@@ -0,0 +1,138 @@
+import type { R8ProviderAccountSnapshotV1 } from './contract';
+
+export type StripeConnectAdapterMode = 'FAKE' | 'LIVE_BLOCKED';
+
+export type StripeConnectAdapter = {
+  mode: StripeConnectAdapterMode;
+  createConnectedAccountStub(input: {
+    economicIdentityId: string;
+    idempotencyKey: string;
+  }): Promise<{ accountId: string }>;
+  createAccountOnboardingLink(input: {
+    accountId: string;
+    refreshUrl: string;
+    returnUrl: string;
+  }): Promise<{ url: string; expiresAtMs: number }>;
+  retrieveAccountSnapshot(accountId: string): Promise<R8ProviderAccountSnapshotV1>;
+};
+
+const fakeAccounts = new Map<string, R8ProviderAccountSnapshotV1>();
+
+function fakeAccountIdForEconomicIdentity(economicIdentityId: string, idempotencyKey: string): string {
+  const digest = Buffer.from(`${economicIdentityId}:${idempotencyKey}`).toString('hex').slice(0, 24);
+  return `acct_fake_r8a_${digest}`;
+}
+
+export function resetFakeStripeConnectAdapterForTests(): void {
+  fakeAccounts.clear();
+}
+
+export function createFakeStripeConnectAdapter(): StripeConnectAdapter {
+  return {
+    mode: 'FAKE',
+    async createConnectedAccountStub({ economicIdentityId, idempotencyKey }) {
+      const accountId = fakeAccountIdForEconomicIdentity(economicIdentityId, idempotencyKey);
+      if (!fakeAccounts.has(accountId)) {
+        fakeAccounts.set(accountId, {
+          detailsSubmitted: false,
+          chargesEnabled: false,
+          payoutsEnabled: false,
+          transfersCapability: 'inactive',
+          requirementsCurrentlyDueCount: 1,
+        });
+      }
+      return { accountId };
+    },
+    async createAccountOnboardingLink({ accountId }) {
+      if (!fakeAccounts.has(accountId)) {
+        throw new Error('FAKE_ACCOUNT_NOT_FOUND');
+      }
+      return {
+        url: `https://connect.stripe.com/setup/s/fake/${accountId}`,
+        expiresAtMs: Date.now() + 30 * 60 * 1000,
+      };
+    },
+    async retrieveAccountSnapshot(accountId) {
+      const snapshot = fakeAccounts.get(accountId);
+      if (!snapshot) {
+        throw new Error('FAKE_ACCOUNT_NOT_FOUND');
+      }
+      return { ...snapshot };
+    },
+  };
+}
+
+/** Test helper — simulates successful hosted onboarding without live Stripe. */
+export function fakeStripeCompleteOnboardingForTests(accountId: string): void {
+  fakeAccounts.set(accountId, {
+    detailsSubmitted: true,
+    chargesEnabled: true,
+    payoutsEnabled: true,
+    transfersCapability: 'active',
+    requirementsCurrentlyDueCount: 0,
+  });
+}
+
+/**
+ * Live adapter is intentionally blocked for R8-A local work.
+ * Accounts v2 Connect mapping must follow current Stripe docs:
+ * https://docs.stripe.com/connect/accounts-v2
+ * https://docs.stripe.com/connect/accounts-v2/connected-account-configuration
+ * Authorized sandbox proof only — never default-on in this gate.
+ */
+export function createLiveStripeConnectAdapterBlocked(): StripeConnectAdapter {
+  return {
+    mode: 'LIVE_BLOCKED',
+    async createConnectedAccountStub() {
+      throw new Error('LIVE_STRIPE_CONNECT_BLOCKED_R8_A');
+    },
+    async createAccountOnboardingLink() {
+      throw new Error('LIVE_STRIPE_CONNECT_BLOCKED_R8_A');
+    },
+    async retrieveAccountSnapshot() {
+      throw new Error('LIVE_STRIPE_CONNECT_BLOCKED_R8_A');
+    },
+  };
+}
+
+export function resolveStripeConnectAdapter(): StripeConnectAdapter {
+  if (process.env.M55_STRIPE_CONNECT_LIVE_ACCOUNT_CREATION === 'true') {
+    return createLiveStripeConnectAdapterBlocked();
+  }
+  return createFakeStripeConnectAdapter();
+}
+
+export function assertSafeRedirectUrl(candidate: string, allowedOrigin: string): string | null {
+  try {
+    const url = new URL(candidate);
+    const allowed = new URL(allowedOrigin);
+    if (url.origin !== allowed.origin) return null;
+    if (url.protocol !== 'https:' && url.hostname !== 'localhost') return null;
+    if (url.username || url.password || url.port) return null;
+    if (!url.pathname.startsWith('/creator/')) return null;
+    return url.toString();
+  } catch {
+    return null;
+  }
+}
+
+export function resolveCreatorProviderPublicOrigin(): string {
+  const raw =
+    process.env.M55_PUBLIC_ORIGIN?.trim() ||
+    process.env.NEXT_PUBLIC_SITE_URL?.trim() ||
+    'http://localhost:3000';
+  return raw.replace(/\/$/, '');
+}
+
+export function buildCreatorPortalProviderReturnUrl(sessionId: string): string {
+  const origin = resolveCreatorProviderPublicOrigin();
+  const url = new URL('/creator/portal', origin);
+  url.searchParams.set('provider', 'return');
+  url.searchParams.set('session', sessionId);
+  return url.toString();
+}
+
+export function buildCreatorPortalProviderRefreshUrl(): string {
+  const origin = resolveCreatorProviderPublicOrigin();
+  return new URL('/creator/portal', origin).toString();
+}
